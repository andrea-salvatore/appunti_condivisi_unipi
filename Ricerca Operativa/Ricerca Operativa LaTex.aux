\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces La \textbf  {Regione Ammissibile} è la zona in cui tutti i colori si sovrappongono (soddisfacendo simultaneamente tutti i vincoli).}}{7}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces La Regione Ammissibile è compresa tra l'asse delle $y$, l'asse delle $x$ e l'intersezione dei due vincoli (area in cui si sovrappongono i colori).}}{9}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Le linee di Isoguadagno (in arancione) salgono o scendono a seconda del valore $k$. Il grafico mostra chiaramente come esse si "spingano" verso l'esterno fino a toccare il bordo limite del poliedro per individuare l'ottimo.}}{10}{figure.caption.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Matrice dei costi. I valori interni indicano il costo preventivato per far realizzare un determinato progetto a un particolare studio (es. il Progetto 2 costa $16$ se svolto dallo Studio 4).}}{11}{table.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Il segmento è l'insieme di tutte le Combinazioni Convesse dei suoi estremi $x_1$ e $x_2$. Un generico punto $y$ si ottiene variando i pesi $\lambda _1$ e $\lambda _2$.}}{15}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Combinazione Convessa di 4 punti dove $x_4$ è interno al poliedro generato.}}{16}{figure.caption.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Esempio di figura NON convessa. La "rientranza" in $x_4$ esclude un'area, violando la regola fondamentale della convessità: il segmento $x_2-x_3$ passa fuori dall'insieme.}}{16}{figure.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Combinazione Conica generata dai punti $x_1$ e $x_2$. L'area ombreggiata rappresenta un poliedro illimitato. Il punto $x_3$ è esterno al cono, pertanto non è combinazione conica di $x_1$ e $x_2$.}}{17}{figure.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Somma di Minkowski dell'Esercizio 7. Il triangolo tratteggiato è $Conv(V)$, mentre le frecce rosse sono le direzioni $Cone(E)$ applicate ai vertici estremi. Il punto $v_1$ massimizza la Funzione Obiettivo. All'inizio può sembrare strano, ma sapendo che il vettore $c$ va praticamente verso il basso, oltre che algebricamente, si capisce come il punto $v_1$ sia l'ottimo a discapito del punto $v_2$ che poteva sembrarlo a primo impatto. È sempre importante vedere dove va la Funzione Obiettivo.}}{28}{figure.caption.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Dati di produzione e costi per i due stabilimenti.}}{30}{table.caption.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Matrice dei costi di assegnamento $3 \times 3$.}}{31}{table.caption.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Matrice di disponibilità oraria e vincoli di studio.}}{32}{table.caption.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces A sinistra, la frontiera chiude lo spazio a sud e a ovest, ma l'area prosegue infinitamente verso nord-est. A destra, un poliedro perfettamente limitato e racchiuso dai suoi vertici in $V$.}}{39}{figure.caption.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Rappresentazione grafica dell'Esercizio 1. La regione ammissibile è limitata. L'ottimo si trova all'intersezione tra il vincolo della Lana e quello del Nylon.}}{41}{figure.caption.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Rappresentazione grafica dell'Esercizio 2. Notare come lo spazio ammissibile (in rosso) sia limitato inferiormente ma illimitato superiormente. Trattandosi di un problema di minimizzazione, l'ottimo si appoggia sul vertice inferiore (6, 4).}}{43}{figure.caption.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Visualizzazione geometrica di un vertice. Il punto nero nell'angolo in alto a destra è un vertice perché non esiste alcun segmento interno al quadrato che lo attraversi usandolo come punto intermedio (nessuna combinazione convessa possibile). Il punto rosso sul lato, invece, \textit  {non} è un vertice: appartiene al segmento che collega i due angoli, dimostrando di poter essere scritto come combinazione convessa con $\lambda $ compreso tra 0 e 1.}}{45}{figure.caption.30}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces A sinistra: La base formata da $V_2$ e $V_4$ genera il punto $(1,0)$ che giace sui bordi della zona azzurra (Poliedro), rispettando tutti i limiti. A destra: Ipotizzando di scegliere la base formata da $V_1$ e $V_2$, la matematica trova il punto di intersezione, ma questo cade ben al di fuori della zona ammissibile (viola platealmente il tetto imposto dal vincolo $V_4$).}}{48}{figure.caption.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Visualizzazione 3D del concetto di Degenerazione. In un problema a 3 variabili ($n=3$), per formare una base occorrono 3 vincoli (piani). Gli angoli della base sono formati esattamente dall'incrocio di 3 piani. L'apice è formato dall'incrocio di 4 piani, superando il numero $n$. Pertanto è una soluzione degenere in cui molteplici basi algebriche descrivono lo stesso punto geometrico.}}{49}{figure.caption.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Vista dall'alto (proiezione ortogonale) della piramide. Da questa prospettiva emerge chiaramente l'anomalia matematica della degenerazione: l'apice è il punto di intersezione in cui collidono simultaneamente ben 4 facce (linee nere). Essendo in uno spazio a 3 variabili ($\mathbb  {R}^3$), l'intersezione di 4 piani in un solo punto crea una ridondanza che genera le molteplici basi degeneri.}}{50}{figure.caption.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Rappresentazione 2D di un vertice degenere su un pentagono. In uno spazio a 2 variabili occorrono due rette per trovare un vertice. Nel vertice evidenziato in rosso convergono simultaneamente 3 rette (la 2, la 3 e la 6). Questo crea una ridondanza per la quale 3 sistemi lineari differenti (le tre basi $B_1, B_2, B_3$) produrranno matematicamente le stesse coordinate geometriche.}}{51}{figure.caption.34}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Tabella dei costi unitari del trasporto. Sulle righe i depositi con le relative disponibilità massime, sulle colonne i supermercati con le relative richieste esatte.}}{52}{table.caption.35}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Costi unitari di produzione per autovettura.}}{71}{table.caption.36}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Costi di assegnamento studi/progetti.}}{74}{table.caption.37}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Rappresentazione del Teorema della Dualità Forte. Qualsiasi soluzione primale restituisce un valore inferiore (o al più uguale) a qualsiasi soluzione duale. L'ottimo si verifica nel punto esatto di collisione tra il massimo sforzo del primale e il minimo sforzo del duale.}}{78}{figure.caption.38}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces La regione ammissibile in PLI corrisponde unicamente ai punti interi (i puntini neri) contenuti nel poliedro $P$.}}{110}{figure.caption.39}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces La funzione obiettivo si spinge verso il massimo e si ferma non appena tocca l'ultimo punto intero ammissibile, che spesso non coincide con il vertice geometrico continuo.}}{111}{figure.caption.40}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces L'ottimo di PLI giace sempre nell'intervallo tra la valutazione inferiore (soluzione intera nota) e la valutazione superiore (rilassato continuo).}}{112}{figure.caption.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Il poligono verde rappresenta il $conv(\mathcal  {S})$, ovvero il più piccolo poliedro che racchiude tutte le soluzioni intere di $P$.}}{113}{figure.caption.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Il vertice ottimo del rilassato continuo (cerchiato in rosso) si trova al di fuori dell'insieme dei punti interi ammissibili.}}{125}{figure.caption.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Il piano di taglio (viola) affetta il poliedro eliminando l'ottimo continuo frazionario, ma preservando rigorosamente tutti i punti interi.}}{125}{figure.caption.46}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Problema di Massimo: l'ottimo continuo è un limite superiore (sovrastima).}}{135}{figure.caption.47}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Problema di Minimo: l'ottimo continuo è un limite inferiore (sottostima).}}{136}{figure.caption.48}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Rappresentazione di un grafo completo a 5 nodi (città). Le linee continue e tratteggiate rappresentano tutti i possibili archi di collegamento.}}{140}{figure.caption.49}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Matrice asimmetrica dei costi per un grafo a 5 nodi.}}{141}{table.caption.50}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Rappresentazione del Ciclo Hamiltoniano $1 \rightarrow 4 \rightarrow 3 \rightarrow 2 \rightarrow 5 \rightarrow 1$.}}{142}{figure.caption.51}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces Il Ciclo Hamiltoniano visto come un perfetto Problema di Assegnamento: da ogni nodo di sinistra parte una sola freccia, e in ogni nodo di destra ne entra una sola.}}{144}{figure.caption.52}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces Un Assegnamento perfetto che forma due cicli disgiunti, violando la regola del TSP.}}{145}{figure.caption.53}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces I cicli Hamiltoniani sono un \textit  {sottoinsieme} degli assegnamenti. Un punto nell'area azzurra rappresenta un assegnamento valido che però forma cicli disgiunti.}}{148}{figure.caption.54}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {32}{\ignorespaces Due cicli disgiunti. Il vincolo SEC impone la creazione di un "ponte" tra l'insieme $S$ e l'insieme $S^C$.}}{148}{figure.caption.55}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces L'algoritmo delle Toppe spezza i due cicli e li ricuce insieme incrociando i percorsi.}}{150}{figure.caption.56}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces Ridisegnando i nodi in forma esagonale, emerge chiaramente come l'algoritmo abbia trasformato i due subtour disgiunti in un unico, ininterrotto Ciclo Hamiltoniano.}}{150}{figure.caption.57}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Matrice dei costi simmetrica (triangolare superiore). Le celle vuote sono omesse per evitare ridondanze.}}{151}{table.caption.58}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {35}{\ignorespaces Percorso trovato dall'algoritmo del Nodo Più Vicino ($1 \to 5 \to 3 \to 4 \to 2 \to 1$).}}{152}{figure.caption.59}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {36}{\ignorespaces Rappresentazione del 1-Albero. Notate come il nodo 5 abbia grado 3 e il nodo 4 abbia grado 1: non è un ciclo Hamiltoniano, ma fornisce il limite inferiore di costo.}}{153}{figure.caption.60}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {37}{\ignorespaces Rappresentazione del 3-Albero.}}{154}{figure.caption.61}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {38}{\ignorespaces Stato Iniziale. $v_S$ Globale = 100. Il GAP è [80, 100]. Il nodo radice prende il nome della variabile su cui stiamo per decidere.}}{158}{figure.caption.62}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {39}{\ignorespaces Primo step. Il problema $P_{12}$ viene potato.}}{158}{figure.caption.63}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {40}{\ignorespaces Albero completo. L'ottimo globale del problema è 90.}}{159}{figure.caption.64}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Matrice dei costi del TSP simmetrico.}}{159}{table.caption.65}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {41}{\ignorespaces Albero di B\&B completo per l'esercizio TSP Simmetrico.}}{161}{figure.caption.66}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {42}{\ignorespaces Esplorazione estrema a sinistra. Negando progressivamente tutti gli archi uscenti dal nodo 1, il problema collassa e diventa vuoto.}}{163}{figure.caption.67}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Esplorazione estrema a destra. Obbligando il nodo 1 a prendere troppi archi, il suo grado eccede 2, rendendo impossibile la formazione di un ciclo Hamiltoniano.}}{163}{figure.caption.68}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {44}{\ignorespaces L'aggiornamento della $v_I$ da parte del ramo destro porta alla chiusura simultanea di tutti gli altri rami aperti dell'albero. Il nodo radice prende il nome della variabile originariamente frazionata ($x_4$), mentre il nodo sinistro prende il nome della nuova variabile frazionata ($x_1$).}}{168}{figure.caption.69}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Matrice binaria di copertura. L'obiettivo è selezionare le colonne (antenne) per garantire almeno un "1" su ogni riga (quartiere).}}{173}{table.caption.70}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Processo di binarizzazione. Inseriamo "1" se il tempo di arrivo è $\leq 7$ minuti, e "0" se il tempo è strettamente maggiore di $7$.}}{176}{table.caption.71}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Vettore riga dei pesi associati ai 9 oggetti da trasportare.}}{179}{table.caption.72}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {45}{\ignorespaces Riempimento ottenuto tramite Best Fit Decreasing. I container 2 e 3 sono stati ottimizzati magistralmente (avanzano solo 1 e 3 unità di spazio libero). Abbiamo utilizzato 4 container in totale.}}{183}{figure.caption.73}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {46}{\ignorespaces Rappresentazione grafica dell'algoritmo NFD. Si notano i grandi spazi sprecati nei primi due container, chiusi prematuramente.}}{184}{figure.caption.74}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {47}{\ignorespaces Rappresentazione grafica dell'algoritmo FFD. I buchi lasciati inizialmente nei primi container sono stati riutilizzati, permettendo di risparmiare un intero container rispetto all'NFD.}}{185}{figure.caption.75}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {48}{\ignorespaces Rappresentazione grafica dell'algoritmo BFD. In questo specifico set numerico, la disposizione finale coincide con quella dell'FFD, confermando l'ottimizzazione in 3 contenitori.}}{186}{figure.caption.76}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {49}{\ignorespaces Grafo Orientato con nodi sorgente (rosso negativo) e destinazione (verde positivo). I numeri sugli archi indicano il costo $c_{ij}$ della tratta.}}{189}{figure.caption.77}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {50}{\ignorespaces Albero di Copertura estratto dal grafo. Notiamo che i nodi 3 e 4 non hanno archi in uscita: sono i nodi terminali, chiamati \textbf  {foglie}.}}{193}{figure.caption.78}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {51}{\ignorespaces Grafo a 4 nodi. In viola ($E_T$) l'albero di copertura che funge da base. In grigio ($E_L$) i collegamenti non di base.}}{195}{figure.caption.80}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {52}{\ignorespaces Grafo a 8 nodi. Le linee viola spesse costituiscono la base $E_T$. L'arco $(1\to 2)$, $(1\to 3)$ e $(3\to 2)$ formano un ciclo chiuso, mentre il nodo 8 resta completamente isolato, violando le regole strutturali di un albero di copertura.}}{197}{figure.caption.81}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {53}{\ignorespaces Grafo a 5 nodi. In viola l'albero di copertura. Notate come i nodi 3 e 4 si comportino da "foglie" assolute, avendo solo archi in entrata e nessuno in uscita all'interno della base viola.}}{200}{figure.caption.82}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {54}{\ignorespaces Nuovo albero di copertura. L'arco $(2\to 3)$ è stato rimosso dalla base in favore di $(5\to 3)$. Si noti come il Nodo 2 sia improvvisamente diventato una foglia.}}{201}{figure.caption.83}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {55}{\ignorespaces L'albero di copertura valido (base $E_T$) con l'aggiunta dei costi di percorrenza per ogni singolo arco orientato.}}{203}{figure.caption.84}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {56}{\ignorespaces Il nuovo grafo logistico. L'albero di copertura in viola collega tutti i nodi senza formare cicli.}}{205}{figure.caption.85}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {57}{\ignorespaces Inserendo l'arco entrante (viola) all'interno dell'albero di base (nero), si crea inevitabilmente un ciclo chiuso tra i nodi 1, 2, 3, 4 e 5.}}{209}{figure.caption.86}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {58}{\ignorespaces Classificazione del ciclo. Il flusso immesso da $(5\to 1)$ attraversa $(1\to 2)$, $(2\to 3)$ e $(4\to 5)$ nel verso corretto (Verdi, $C^+$). Per richiudersi in 5, è costretto a percorrere l'arco $(4\to 3)$ "contromano" rispetto alla sua freccia originale (Rosso, $C^-$). Gli archi estranei al ciclo (grigi) vengono ignorati dall'aggiornamento del flusso.}}{210}{figure.caption.87}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {59}{\ignorespaces Grafo a 6 nodi iniziale. Le linee viola formano l'albero di copertura. Notiamo subito che le "foglie" dell'albero (nodi con un solo arco viola collegato) sono il Nodo 1 e il Nodo 6.}}{212}{figure.caption.89}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {60}{\ignorespaces Il nuovo albero di copertura. L'arco $(1\to 2)$ è diventato tratteggiato (non di base), mentre $(1\to 3)$ è entrato a far parte della base viola.}}{214}{figure.caption.90}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {61}{\ignorespaces Grafo bipartito completo (16 archi). A sinistra le "Persone" (Sorgenti), a destra i "Lavori" (Destinazioni).}}{222}{figure.caption.94}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {62}{\ignorespaces L'Albero di Copertura per l'Assegnamento (i 7 archi di base).}}{222}{figure.caption.95}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {63}{\ignorespaces Rete capacitata. Su ogni singolo arco è riportata la coppia di valori $[Costo, Capacita']$.}}{224}{figure.caption.96}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {64}{\ignorespaces Rete Capacitata a 6 nodi. L'albero di base è in viola, l'arco saturo è in rosso, gli archi non di base sono tratteggiati. I valori sono disposti in modo pulito e distanziato come coppia $[Costo, Capacita']$.}}{228}{figure.caption.97}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {65}{\ignorespaces Rete Capacitata a 5 nodi. L'albero di base è in viola, l'arco saturo è in rosso, gli archi non di base sono tratteggiati. I valori sono disposti in modo pulito come coppia $[Costo, Capacita']$.}}{229}{figure.caption.98}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {66}{\ignorespaces Rete bipartita del problema del trasporto. Costi di percorrenza degli archi: $\mathbf  {(1\to 3)} \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}C=6$; \hskip 1em\relax $\mathbf  {(1\to 4)} \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}C=9$; \hskip 1em\relax $\mathbf  {(1\to 5)} \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}C=8$; \hskip 1em\relax $\mathbf  {(2\to 3)} \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}C=7$; \hskip 1em\relax $\mathbf  {(2\to 4)} \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}C=11$; \hskip 1em\relax $\mathbf  {(2\to 5)} \DOTSB \tmspace  +\thickmuskip {.2777em}\DOTSB \Relbar \joinrel \Rightarrow \tmspace  +\thickmuskip {.2777em}C=9$.}}{239}{figure.caption.101}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {67}{\ignorespaces Tentativo di costruzione manuale. L'albero di copertura $T$ (viola) è forzato appositamente sugli archi peggiori della rete, lasciando le vere convenienze in $L$.}}{240}{figure.caption.102}\protected@file@percent }
