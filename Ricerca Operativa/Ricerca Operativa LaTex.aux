\@writefile{lof}{\contentsline {figure}{\numberline {71}{\ignorespaces Rappresentazione del cammino degenerato. L'arco $(3\to 4)$ verde tratteggiato è escluso, mentre subentra l'arco blu $(2\to 4)$, generando un nuovo albero equivalente.}}{249}{figure.caption.112}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {72}{\ignorespaces Rete dei cammini per l'esercizio assegnato, con i costi $c_{ij}$ specificati sui rispettivi archi.}}{250}{figure.caption.113}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {73}{\ignorespaces Albero Ottimo dei Cammini Minimi finale. In viola sono evidenziati gli archi appartenenti all'albero di copertura ricavati dal vettore dei predecessori $P$: $(1\to 3), (3\to 2), (2\to 4)$. Gli archi non convenienti scartati dall'algoritmo restano in grigio.}}{251}{figure.caption.118}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {74}{\ignorespaces Generazione del ciclo $C$ tramite l'inserimento dell'arco entrante $(i,j)$ in $L$. Gli archi viola fanno parte di $T$.}}{253}{figure.caption.119}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {75}{\ignorespaces Rete di partenza. In viola l'albero di copertura $T$, in rosso l'arco saturo $U$.}}{256}{figure.caption.122}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {76}{\ignorespaces Rete per il problema del cammino minimo con vincoli di risorse. Sugli archi sono riportati i pesi corrispondenti.}}{258}{figure.caption.123}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {77}{\ignorespaces Rete del Problema del Flusso Massimo. I valori sugli archi indicano le portate massime (banda) $u_{ij}$.}}{260}{figure.caption.124}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {78}{\ignorespaces Rete Modificata con Arco di Ritorno fittizio. Notare che ora il bilancio ai nodi è zero per tutti ($b_i=0$).}}{263}{figure.caption.125}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {79}{\ignorespaces Rappresentazione di due tagli netti che frammentano il grafo e isolano il nodo 1 dal nodo 6. La \textbf  {linea verde} (Taglio A) separa la sorgente recidendo gli archi $(1\to 2)$ e $(1\to 3)$. La \textbf  {linea gialla} (Taglio B) intercetta gli archi $(2\to 4)$, $(3\to 4)$ e $(3\to 5)$. Entrambi i tagli eliminano ogni possibile cammino residuo tra sorgente e destinazione.}}{264}{figure.caption.126}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {80}{\ignorespaces Grafo di Inizializzazione. In viola l'albero di copertura $T$ iniziale. Flussi tutti a zero.}}{265}{figure.caption.127}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {81}{\ignorespaces Rete dell'Esercizio 2. Sono raffigurati i 4 nodi e i 5 archi con le rispettive portate $u_{ij}$. In viola gli archi di base $T$, in rosso gli archi saturi $U$, in grigio tratteggiato gli archi vuoti $L$.}}{267}{figure.caption.128}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {82}{\ignorespaces Esempio di grafo a 4 nodi con relative portate massime $u_{ij}$. In viola gli archi assegnati teoricamente all'insieme $T$, in grigio tratteggiato l'insieme $L$.}}{268}{figure.caption.129}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {83}{\ignorespaces Grafo iniziale del problema di Flusso Massimo. I valori sugli archi indicano le portate massime $u_{ij}$. Il nodo 1 è la sorgente $s$, il nodo 6 è la destinazione $t$.}}{269}{figure.caption.130}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {84}{\ignorespaces Algoritmo della Croce per la ricerca del Cammino Aumentante. \textbf  {A sinistra:} Lo svolgimento cronologico dell'esplorazione. \textbf  {A destra:} La procedura di Backtracking (tracciamento a ritroso). Si parte dall'obiettivo raggiunto nella colonna destra (nodo 6) e si segue la freccia orizzontale verso il nodo che lo ha generato a sinistra (nodo 4). Per capire da dove derivi il nodo 4, si traccia una freccia diagonale verso la sua prima comparsa nella colonna destra, risalendo poi in orizzontale al nodo che lo ha generato (nodo 2), e così via fino a raggiungere la sorgente 1. Questo definisce inequivocabilmente il cammino: $1 \to 2 \to 4 \to 6$.}}{271}{figure.caption.131}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {85}{\ignorespaces Grafo aggiornato al termine della Prima Iterazione. In rosso è evidenziato il cammino aumentante appena saturato. I valori esposti corrispondono alle nuove Capacità Residue $r_{ij}$ disponibili.}}{272}{figure.caption.132}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {86}{\ignorespaces Grafo iniziale del problema di Flusso Massimo. I valori esposti indicano la portata massima $u_{ij}$ di ciascun arco.}}{272}{figure.caption.133}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {87}{\ignorespaces L'algoritmo della Croce. A destra, il tracciamento a ritroso ci definisce il cammino aumentante: dal nodo finale 6 risaliamo al 4; dal 4 risaliamo alla sua origine (2); dal 2 risaliamo all'1. Il circuito è quindi $1 \to 2 \to 4 \to 6$.}}{273}{figure.caption.134}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {88}{\ignorespaces Grafo con le nuove capacità residue. Gli archi in viola evidenziano il transito appena effettuato. Notiamo come l'arco $(1\to 2)$ sia sceso a 0, rendendo la via momentaneamente impercorribile in avanti.}}{273}{figure.caption.135}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {89}{\ignorespaces Grafo Residuo. Compaiono in blu tratteggiato gli archi fittizi inversi che permettono al flusso di tornare indietro se necessario. I valori neri, posti sotto l'arco, indicano le capacità residue dirette, mentre i valori blu, posti sopra l'arco, indicano i flussi revocabili all'indietro.}}{274}{figure.caption.136}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {90}{\ignorespaces Il tracciamento a ritroso evidenzia un cammino molto particolare: $1 \to 3 \to 4 \to \mathbf  {2} \to 5 \to 6$. Il passaggio da 4 a 2 avviene tramite l'arco inverso blu: stiamo dirottando indietro il flusso mandato in precedenza.}}{275}{figure.caption.137}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {91}{\ignorespaces Grafo di partenza dell'Esercizio 2. I valori posti sugli archi indicano unicamente la capacità massima $u_{ij}$. Essendo il flusso iniziale nullo, le capacità residue $r_{ij}$ attuali coincidono con le $u_{ij}$.}}{276}{figure.caption.138}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {92}{\ignorespaces Tramite il tracciamento a ritroso identifichiamo il cammino aumentante: $1 \to 2 \to 5$.}}{276}{figure.caption.139}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {93}{\ignorespaces Grafo Residuo dopo la prima iterazione. I numeri neri posti sotto/accanto all'arco indicano la capacità residua ancora sfruttabile nel verso originario. I numeri blu posti sugli archi tratteggiati rappresentano il flusso appena inviato, ora revocabile (arco inverso). Notiamo l'assenza dell'arco diretto $(2\to 5)$ in quanto saturato.}}{277}{figure.caption.140}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {94}{\ignorespaces Tracciamento del secondo cammino aumentante sul Grafo Residuo. Il percorso è netto e lineare: $1 \to 3 \to 5$.}}{277}{figure.caption.141}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {95}{\ignorespaces Il Grafo originario. Sugli archi è annotata la coppia di valori $[x_{ij}, u_{ij}]$, indicante rispettivamente la distribuzione del flusso corrente e la portata nominale, per evidenziare in maniera compatta quali archi abbiano raggiunto i propri limiti superiore o inferiore.}}{278}{figure.caption.142}\protected@file@percent }
