\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Libro di Ricerca Operativa del prof. Massimo Pappalardo}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:mio_grafico}{{1}{2}{Libro di Ricerca Operativa del prof. Massimo Pappalardo}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces La Regione Ammissibile è la zona dove tutti i colori si sovrappongono.}}{7}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces con Regione Ammissibile compresa tra l'asse delle y, l'asse delle x e l'intersezione dei due vincoli. vedi i colori per aiutarti. PS: la linea rossa crea quell'angolo in alto per un semplice errore di formattazione grafica.}}{9}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Le linee di Isoguadagno sono quelle arancioni, perpendicolari alla direzione del vettore della FO e che salgono e/o scendono a seconda del valore K. Dal grafico si può intravedere il fatto che ci sarà un valore K che toccherà i bordi del poliedro. In uno dei punti dei bordi del Poliedro, quindi, c'è l'ottimo del problema. Per questo è molto utile usarle a questo scopo.}}{10}{figure.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Il segmento è l'insieme di tutte le Combinazioni Convesse dei suoi estremi $x_1$ e $x_2$. Un generico punto $y$ si ottiene variando i pesi $\lambda _1$ e $\lambda _2$.}}{15}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Combinazione Convessa di 4 punti dove $x_4$ è interno al poliedro generato.}}{16}{figure.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Esempio di figura NON convessa. La "rientranza" in $x_4$ esclude un'area, violando la regola fondamentale della convessità: il segmento $x_2-x_3$ passa fuori dall'insieme.}}{16}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Combinazione Conica generata dai punti $x_1$ e $x_2$. L'area ombreggiata rappresenta un poliedro illimitato. Il punto $x_3$ è esterno al cono, pertanto non è combinazione conica di $x_1$ e $x_2$.}}{17}{figure.caption.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Somma di Minkowski dell'Esercizio 7. Il triangolo tratteggiato è $Conv(V)$, mentre le frecce rosse sono le direzioni $Cone(E)$ applicate ai vertici estremi. Il punto $v_1$ massimizza la Funzione Obiettivo. All'inizio può sembrare strano, ma sapendo che il vettore $c$ va praticamente verso il basso, oltre che algebricamente, si capisce come il punto $v_1$ sia l'ottimo a discapito del punto $v_2$ che poteva sembrarlo a primo impatto. È sempre importante vedere dove va la Funzione Obiettivo.}}{28}{figure.caption.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces A sinistra, la frontiera chiude lo spazio a sud e a ovest, ma l'area prosegue infinitamente verso nord-est. A destra, un poliedro perfettamente limitato e racchiuso dai suoi vertici in $V$.}}{31}{figure.caption.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Rappresentazione grafica dell'Esercizio 1. La regione ammissibile è limitata. L'ottimo si trova all'intersezione tra il vincolo della Lana e quello del Nylon.}}{33}{figure.caption.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Rappresentazione grafica dell'Esercizio 2. Notare come lo spazio ammissibile (in rosso) sia limitato inferiormente ma illimitato superiormente. Trattandosi di un problema di minimizzazione, l'ottimo si appoggia sul vertice inferiore (6, 4).}}{35}{figure.caption.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Visualizzazione geometrica di un vertice. Il punto nero nell'angolo in alto a destra è un vertice perché non esiste alcun segmento interno al quadrato che lo attraversi usandolo come punto intermedio (nessuna combinazione convessa possibile). Il punto rosso sul lato, invece, \textit  {non} è un vertice: appartiene al segmento che collega i due angoli, dimostrando di poter essere scritto come combinazione convessa con $\lambda $ compreso tra 0 e 1.}}{37}{figure.caption.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces A sinistra: La base formata da $V_2$ e $V_4$ genera il punto $(1,0)$ che giace sui bordi della zona azzurra (Poliedro), rispettando tutti i limiti. A destra: Ipotizzando di scegliere la base formata da $V_1$ e $V_2$, la matematica trova il punto di intersezione, ma questo cade ben al di fuori della zona ammissibile (viola platealmente il tetto imposto dal vincolo $V_4$).}}{40}{figure.caption.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Visualizzazione 3D del concetto di Degenerazione. In un problema a 3 variabili ($n=3$), per formare una base occorrono 3 vincoli (piani). Gli angoli della base sono formati esattamente dall'incrocio di 3 piani. L'apice è formato dall'incrocio di 4 piani, superando il numero $n$. Pertanto è una soluzione degenere in cui molteplici basi algebriche descrivono lo stesso punto geometrico.}}{41}{figure.caption.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Vista dall'alto (proiezione ortogonale) della piramide. Da questa prospettiva emerge chiaramente l'anomalia matematica della degenerazione: l'apice è il punto di intersezione in cui collidono simultaneamente ben 4 facce (linee nere). Essendo in uno spazio a 3 variabili ($\mathbb  {R}^3$), l'intersezione di 4 piani in un solo punto crea una ridondanza che genera le molteplici basi degeneri.}}{42}{figure.caption.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Rappresentazione 2D di un vertice degenere su un pentagono. In uno spazio a 2 variabili occorrono due rette per trovare un vertice. Nel vertice evidenziato in rosso convergono simultaneamente 3 rette (la 2, la 3 e la 6). Questo crea una ridondanza per la quale 3 sistemi lineari differenti (le tre basi $B_1, B_2, B_3$) produrranno matematicamente le stesse coordinate geometriche.}}{43}{figure.caption.24}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Tabella dei costi unitari del trasporto. Sulle righe i depositi con le relative disponibilità massime, sulle colonne i supermercati con le relative richieste esatte.}}{44}{table.caption.25}\protected@file@percent }
